@baseUrl = http://localhost:8000/api
@bankToken = demo-bank-token
@documentId = 1

### Войти директором перед запросами заявок
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"login":"director","password":"demo-credit-2026"}

### Каталог трёх продуктов
GET {{baseUrl}}/products

### Только требующие решения (интерфейс по умолчанию)
GET {{baseUrl}}/bank/applications?view=needs_decision
X-Bank-Token: {{bankToken}}

### Все заявки, включая выданные
GET {{baseUrl}}/bank/applications?view=all
X-Bank-Token: {{bankToken}}

@sessionToken = {{login.response.body.$.access_token}}

### Текущая учётная запись
GET {{baseUrl}}/auth/me
Authorization: Bearer {{sessionToken}}

### Демо-учётки (DEMO_MODE=true)
GET {{baseUrl}}/auth/demo-accounts


### Проверка сервиса
GET {{baseUrl}}/health

### Демо-профили
GET {{baseUrl}}/demo-profiles

### Поиск известной компании
GET {{baseUrl}}/companies/lookup?inn=7712345678

### Неизвестный ИНН: 404/COMPANY_NOT_FOUND с понятным сообщением
GET {{baseUrl}}/companies/lookup?inn=0000000000

### Невалидный ИНН: 422
GET {{baseUrl}}/companies/lookup?inn=123

### Создать одобряемую заявку: 201/SUBMITTED.
# Повтор этого же запроса: 200, прежний ID. Для нового прогона выполните reset в конце файла.
# @name approved
POST {{baseUrl}}/applications
Authorization: Bearer {{sessionToken}}
Content-Type: application/json
Idempotency-Key: collection-approved-1

{"company":{"inn":"7712345678","name":"ООО «Альфа Ритейл»","annual_revenue":180000000,"monthly_payments":400000,"credit_history":"excellent","business_age_years":7,"segment":"retail"},"requested_amount":10000000,"term_months":36,"goal":"working_capital","consent":true}

### Опрос: дождаться APPROVED, 97 баллов, 19%, 10 000 000
GET {{baseUrl}}/applications/{{approved.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### Неверный код: 400, расходует попытку
POST {{baseUrl}}/applications/{{approved.response.body.$.id}}/sign
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"code":"0000"}

### Подписать одобренную заявку: 200/SIGNED
POST {{baseUrl}}/applications/{{approved.response.body.$.id}}/sign
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"code":"1234"}

### Опрос: через ~1 сек DISBURSED
GET {{baseUrl}}/applications/{{approved.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### Создать встречное предложение
# @name counter
POST {{baseUrl}}/applications
Authorization: Bearer {{sessionToken}}
Content-Type: application/json
Idempotency-Key: collection-counter-1

{"company":{"inn":"500100732259","name":"ИП Иванов","annual_revenue":24000000,"monthly_payments":400000,"credit_history":"fair","business_age_years":3,"segment":"services"},"requested_amount":10000000,"term_months":36,"goal":"working_capital","consent":true}

### Опрос: дождаться COUNTER_OFFER, 46 баллов, 24%, 2 500 000
GET {{baseUrl}}/applications/{{counter.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### Прямая подпись встречного предложения: 409
POST {{baseUrl}}/applications/{{counter.response.body.$.id}}/sign
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"code":"1234"}

### Принять предложение: OFFER_ACCEPTED
POST {{baseUrl}}/applications/{{counter.response.body.$.id}}/accept-offer
Authorization: Bearer {{sessionToken}}

### Подписать принятое предложение: SIGNED
POST {{baseUrl}}/applications/{{counter.response.body.$.id}}/sign
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"code":"1234"}

### Опрос: DISBURSED
GET {{baseUrl}}/applications/{{counter.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### Создать отказ
# @name rejected
POST {{baseUrl}}/applications
Authorization: Bearer {{sessionToken}}
Content-Type: application/json
Idempotency-Key: collection-rejected-1

{"company":{"inn":"7723456789","name":"ООО «Вектор»","annual_revenue":9000000,"monthly_payments":300000,"credit_history":"poor","business_age_years":1,"segment":"production"},"requested_amount":10000000,"term_months":36,"goal":"working_capital","consent":true}

### Опрос: REJECTED, 8 баллов, рекомендации и дата повторной подачи
GET {{baseUrl}}/applications/{{rejected.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### История
GET {{baseUrl}}/applications?limit=50&offset=0
Authorization: Bearer {{sessionToken}}

### Сегментная лента
GET {{baseUrl}}/feed?segment=retail

### Лента после отказа
GET {{baseUrl}}/feed?segment=production&context=rejected

### Создать отдельную заявку для ручного одобрения
# @name bankReview
POST {{baseUrl}}/applications
Authorization: Bearer {{sessionToken}}
Content-Type: application/json
Idempotency-Key: collection-bank-1

{"company":{"inn":"500100732259","name":"ИП Иванов","annual_revenue":24000000,"monthly_payments":400000,"credit_history":"fair","business_age_years":3,"segment":"services"},"requested_amount":10000000,"term_months":36,"goal":"working_capital","consent":true}

### Дождаться COUNTER_OFFER
GET {{baseUrl}}/applications/{{bankReview.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### Очередь банка: полный ответ с факторами
GET {{baseUrl}}/bank/applications?limit=50&offset=0
X-Bank-Token: {{bankToken}}

### Ручное одобрение исходных 10 000 000 по ставке 24%
POST {{baseUrl}}/bank/applications/{{bankReview.response.body.$.id}}/decision
Content-Type: application/json
X-Bank-Token: {{bankToken}}

{"action":"approve","comment":"Дополнительные данные проверены в синтетическом демо"}

### Подписать вручную одобренную заявку без accept-offer
POST {{baseUrl}}/applications/{{bankReview.response.body.$.id}}/sign
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"code":"1234"}

### Создать отдельную заявку для ручного отказа
# @name bankReject
POST {{baseUrl}}/applications
Authorization: Bearer {{sessionToken}}
Content-Type: application/json
Idempotency-Key: collection-bank-reject-1

{"company":{"inn":"7712345678","name":"ООО «Альфа Ритейл»","annual_revenue":180000000,"monthly_payments":400000,"credit_history":"excellent","business_age_years":7,"segment":"retail"},"requested_amount":10000000,"term_months":36,"goal":"working_capital","consent":true}

### Дождаться APPROVED
GET {{baseUrl}}/applications/{{bankReject.response.body.$.id}}
Authorization: Bearer {{sessionToken}}

### Ручной отказ: прежнее одобрение останется в журнале
POST {{baseUrl}}/bank/applications/{{bankReject.response.body.$.id}}/decision
Content-Type: application/json
X-Bank-Token: {{bankToken}}

{"action":"reject","comment":"Дополнительные обстоятельства синтетического примера"}

### Для score 8 банк не придумывает ставку: 409/INVALID_TRANSITION, details.reason=BANK_RATE_UNAVAILABLE
POST {{baseUrl}}/bank/applications/{{rejected.response.body.$.id}}/decision
Content-Type: application/json
X-Bank-Token: {{bankToken}}

{"action":"approve","comment":"Проверка ограничения SPEC"}

### Без банковского токена: 401
GET {{baseUrl}}/bank/applications

### Повтор NEEDS_RECHECK: подставьте ID заявки со сбоем, иначе 409
POST {{baseUrl}}/applications/replace-with-needs-recheck-id/retry
Authorization: Bearer {{sessionToken}}

### Сброс: УДАЛЯЕТ ВСЕ ДЕМО-ЗАЯВКИ, компании и лента сохраняются
POST {{baseUrl}}/demo/reset
Authorization: Bearer {{sessionToken}}

### Прочитать пульт (вошедший клиент)
GET {{baseUrl}}/demo/failures
Authorization: Bearer {{sessionToken}}

### Отключить БКИ без рестарта (director / underwriter)
POST {{baseUrl}}/demo/failures
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"bki":"down"}

### Восстановить БКИ, затем вызвать retry у заявки
POST {{baseUrl}}/demo/failures
Authorization: Bearer {{sessionToken}}
Content-Type: application/json

{"bki":"ok"}

### Войти сотрудником банка
# @name bankLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"login":"underwriter","password":"demo-credit-2026"}

### Карточка банка: подставьте ID существующей заявки
GET {{baseUrl}}/bank/applications/{{approved.response.body.$.id}}
Authorization: Bearer {{bankLogin.response.body.$.access_token}}

### Выйти директором; прежний sessionToken станет недействительным
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{sessionToken}}

### Своя оферта для Иванова: выполнить до accept-offer/sign
POST {{baseUrl}}/bank/applications/{{counter.response.body.$.id}}/decision
X-Bank-Token: {{bankToken}}
Content-Type: application/json

{"action":"counter","amount":1000000,"term_months":24,"comment":"Меньшая сумма на согласованный срок"}

### Запросить документ у неподписанной заявки
POST {{baseUrl}}/bank/applications/{{counter.response.body.$.id}}/decision
X-Bank-Token: {{bankToken}}
Content-Type: application/json

{"action":"request_info","checklist":["Выписка"],"comment":"Нужен синтетический документ для демо"}

### Загрузить синтетический PDF (положить sample.pdf рядом с этим файлом)
POST {{baseUrl}}/applications/{{counter.response.body.$.id}}/documents
Authorization: Bearer {{sessionToken}}
Content-Type: multipart/form-data; boundary=DemoBoundary

--DemoBoundary
Content-Disposition: form-data; name="kind"

Выписка
--DemoBoundary
Content-Disposition: form-data; name="consent"

true
--DemoBoundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ./sample.pdf
--DemoBoundary--

### Скачать документ клиентом: documentId взять из application.documents
GET {{baseUrl}}/applications/{{counter.response.body.$.id}}/documents/{{documentId}}
Authorization: Bearer {{sessionToken}}

### Скачать тот же документ сотрудником
GET {{baseUrl}}/bank/applications/{{counter.response.body.$.id}}/documents/{{documentId}}
X-Bank-Token: {{bankToken}}
