# true — работать без бэкенда (данные в localStorage браузера), false — ходить в настоящий API
VITE_USE_MOCK=true
# Адрес API. В Docker nginx проксирует /api на backend:8000
VITE_API_BASE_URL=/api
# true — мок имитирует сбой БКИ (заявка уходит в «Нужна повторная проверка»)
VITE_MOCK_BKI_FAILURE=false
